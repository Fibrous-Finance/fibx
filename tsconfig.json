{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "."
	},
	"include": ["src/**/*", "ui/dev-host/bridge.ts"],
	"exclude": ["node_modules", "dist"]
}
